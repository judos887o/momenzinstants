local sliding=false
local function setRadius(val)
    Shared.StompRadius=math.clamp(math.floor(val+0.5),0,50)
    lbl.Text=("Radius: %d studs"):format(Shared.StompRadius)
    local w=bar.AbsoluteSize.X
    local ratio=(w>0) and (Shared.StompRadius/50) or 0
    fill.Size=UDim2.new(ratio,0,1,0)
    local x=math.floor(ratio*w)
    thumb.Position=UDim2.new(0,x-6,0.5,-6)
end

local function posToRadius(x)
    local bx=bar.AbsolutePosition.X
    local w=bar.AbsoluteSize.X
    local r=(w>0) and math.clamp((x-bx)/w,0,1) or 0
    setRadius(r*50)
end

bar.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        sliding=true
        posToRadius(input.Position.X)
    end
end)
bar.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        sliding=false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not sliding then return end
    if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
        posToRadius(input.Position.X)
    end
end)

