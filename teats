local valid={["Head"]=true,["HumanoidRootPart"]=true,["Torso"]=true,["Left Leg"]=true,["Right Leg"]=true,["Left Arm"]=true,["Right Arm"]=true,["UpperTorso"]=true,["LowerTorso"]=true,["LeftUpperArm"]=true,["LeftLowerArm"]=true,["RightUpperArm"]=true,["RightLowerArm"]=true,["LeftHand"]=true,["RightHand"]=true,["LeftUpperLeg"]=true,["LeftLowerLeg"]=true,["RightUpperLeg"]=true,["RightLowerLeg"]=true,["LeftFoot"]=true,["RightFoot"]=true}
local legParts={["LeftFoot"]=true,["RightFoot"]=true,["LeftLowerLeg"]=true,["RightLowerLeg"]=true,["LeftUpperLeg"]=true,["RightUpperLeg"]=true,["LeftLeg"]=true,["RightLeg"]=true}

local function findKOValue(ch)
    local be=ch:FindFirstChild("BodyEffects")
    local ko=be and (be:FindFirstChild("K.O") or be:FindFirstChild("KO") or be:FindFirstChild("Knocked"))
    if ko and ko:IsA("BoolValue") then return ko end
    ko=ch:FindFirstChild("K.O") or ch:FindFirstChild("KO") or ch:FindFirstChild("Knocked")
    if ko and ko:IsA("BoolValue") then return ko end
    for _,d in ipairs(ch:GetDescendants()) do
        if (d.Name=="K.O" or d.Name=="KO" or d.Name=="Knocked") and d:IsA("BoolValue") then return d end
    end
    return nil
end

local function isKO(p)
    local ch=p and p.Character; if not ch then return false end
    if ch:FindFirstChildOfClass("ForceField") then return false end
    local ko=findKOValue(ch)
    if ko and ko.Value==true then
        local be=ch:FindFirstChild("BodyEffects"); local dead=be and be:FindFirstChild("Dead")
        if dead and dead.Value==true then return false end
        local hum=ch:FindFirstChildOfClass("Humanoid"); if hum and hum.Health<=0 then return false end
        return true
    end
    local hum=ch:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum.Health > 20 then return false end 
        if hum.Health <= 0 then return false end
        local st=hum:GetState()
        if st==Enum.HumanoidStateType.Ragdoll or st==Enum.HumanoidStateType.FallingDown or st==Enum.HumanoidStateType.Physics or hum.PlatformStand then
            return true
        end
    end
    return false
end

local function inRange(p)
    local myCh=LP.Character; if not myCh then return false end
    local myHRP=myCh:FindFirstChild("HumanoidRootPart"); if not myHRP then return false end
    local ch=p and p.Character; if not ch then return false end
    for _,part in ipairs(ch:GetChildren()) do
        if part:IsA("BasePart") and valid[part.Name] then
            if (myHRP.Position-part.Position).Magnitude<=TOUCH_RANGE then return true end
        end
    end
    return false
end

local function nearestLeg(ch,ref)
    local best,bestD
    for _,p in ipairs(ch:GetChildren()) do
        if p:IsA("BasePart") and legParts[p.Name] then
            local d=(ref-p.Position).Magnitude
            if not bestD or d<bestD then best,bestD=p,d end
        end
    end
    return best,bestD
end

local function getNearest(maxDist)
    local myCh=LP.Character; if not myCh then return end
    local hrp=myCh:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local bestPlr,bestPart,bestDist=nil,nil,math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP and isKO(p) then
            local ch=p.Character
            if ch then
                local leg,d=nearestLeg(ch,hrp.Position)
                if leg then
                    local dd=(hrp.Position-leg.Position).Magnitude
                    if dd<bestDist and dd<=maxDist then
                        bestPlr,bestPart,bestDist=p,leg,dd
                    end
                end
            end
        end
    end
    return bestPlr,bestPart,bestDist
end

local function hookAnim(ch)
    task.spawn(function()
        local hum=ch:WaitForChild("Humanoid",5); if not hum then return end
        local animator=hum:WaitForChild("Animator",5); if not animator then return end
        table.insert(Shared.Connections[KEY_CORE], animator.AnimationPlayed:Connect(function(track)
            local id=track.Animation and track.Animation.AnimationId or ""
            if tostring(id):find(ANIM_ID) then track:AdjustSpeed(100) end
        end))
    end)
end

table.insert(Shared.Connections[KEY_CORE], RunService.Heartbeat:Connect(function()
    local now=tick(); if now-lastStomp<MIN_CD then return end
    local myCh=LP.Character; if not myCh then return end
    local myHRP=myCh:FindFirstChild("HumanoidRootPart"); if not myHRP then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP and isKO(p) and inRange(p) then
            if MAINEVENT then MAINEVENT:FireServer("STOMP") end
            lastStomp=now
            return
        end
    end
end))

table.insert(Shared.Connections[KEY_CORE], RunService.Heartbeat:Connect(function()
    if not Shared.StompNearestEnabled then return end
    local myCh=LP.Character; if not myCh then return end
    local myHRP=myCh:FindFirstChild("HumanoidRootPart"); if not myHRP then return end
    local t,leg=getNearest(Shared.StompRadius)
    if t and leg then
        local thrp=t.Character and t.Character:FindFirstChild("HumanoidRootPart")
        if thrp then
            local desired=leg.Position+Vector3.new(0,1.05,0.2)
            myHRP.CFrame=CFrame.new(desired,thrp.Position)
        end
    end
end))

