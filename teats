local ringFolder = Instance.new("Folder")
ringFolder.Name = "Schmeckt_InstantStomp_Ring"
ringFolder.Parent = Workspace

local SEGMENTS = 64
local THICK = 0.08
local YOFFSET = 0.03
local segments = {}

for i = 1, SEGMENTS do
    local p = Instance.new("Part")
    p.Name = "Seg" .. i
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.Material = Enum.Material.Neon
    p.Color = Theme.Purple
    p.Transparency = 1
    p.Size = Vector3.new(THICK, THICK, 0.2)
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = ringFolder
    segments[i] = p
end

local rcParams = RaycastParams.new()
rcParams.FilterType = Enum.RaycastFilterType.Exclude
rcParams.IgnoreWater = true

local ringColorPhase = 0

local function updateRing(dt)
    local ch = localPlayer.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    rcParams.FilterDescendantsInstances = {ch}
    local res = Workspace:Raycast(hrp.Position, Vector3.new(0, -100, 0), rcParams)
    local center = (res and res.Position or (hrp.Position - Vector3.new(0, 3, 0))) + Vector3.new(0, YOFFSET, 0)
    local r = Shared.StompRadius
    local vis = Shared.StompNearestEnabled
    local twoPi = math.pi * 2
    
    ringColorPhase = (ringColorPhase + dt * 0.5) % 1
    
    for i = 1, SEGMENTS do
        local a1 = twoPi * (i - 1) / SEGMENTS
        local a2 = twoPi * i / SEGMENTS
        local p1 = center + Vector3.new(math.cos(a1) * r, 0, math.sin(a1) * r)
        local p2 = center + Vector3.new(math.cos(a2) * r, 0, math.sin(a2) * r)
        local mid = (p1 + p2) / 2
        local dir = (p2 - p1)
        local len = math.max(dir.Magnitude, 1e-4)
        local cf = CFrame.lookAt(mid, mid + dir, Vector3.yAxis)
        local part = segments[i]
        part.Size = Vector3.new(THICK, THICK, len)
        part.CFrame = cf
        part.Transparency = vis and 0.4 or 1
        
        if vis then
            local segPhase = (ringColorPhase + i / SEGMENTS) % 1
            local colors = {
                Color3.fromRGB(255, 20, 147),
                Color3.fromRGB(220, 20, 60),
                Color3.fromRGB(180, 50, 255),
                Color3.fromRGB(255, 105, 180),
            }
            local index = math.floor(segPhase * #colors) + 1
            local nextIndex = (index % #colors) + 1
            local localT = (segPhase * #colors) % 1
            part.Color = colors[index]:Lerp(colors[nextIndex], localT)
        end
    end
end

table.insert(Shared.Connections[key], RunService.Heartbeat:Connect(updateRing))


local mainColorPhase = 0
local mainColorConnection = RunService.Heartbeat:Connect(function(dt)
    if not MainFrame.Parent then
        mainColorConnection:Disconnect()
        return
    end
    
    mainColorPhase = (mainColorPhase + dt * 0.6) % 1
    
    local function lerpColor(t)
        local colors = {
            Color3.fromRGB(255, 20, 147),
            Color3.fromRGB(220, 20, 60),
            Color3.fromRGB(180, 50, 255),
            Color3.fromRGB(255, 105, 180),
        }
        local index = math.floor(t * #colors) + 1
        local nextIndex = (index % #colors) + 1
        local localT = (t * #colors) % 1
        return colors[index]:Lerp(colors[nextIndex], localT)
    end
    
    local o1 = mainColorPhase
    local o2 = (mainColorPhase + 0.33) % 1
    local o3 = (mainColorPhase + 0.66) % 1
    
    mainStrokeGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, lerpColor(o1)),
        ColorSequenceKeypoint.new(0.5, lerpColor(o2)),
        ColorSequenceKeypoint.new(1, lerpColor(o3))
    })
    
    headerTextGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, lerpColor(o1)),
        ColorSequenceKeypoint.new(0.5, lerpColor(o2)),
        ColorSequenceKeypoint.new(1, lerpColor(o3))
    })
    
    headerXGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, lerpColor(o2)),
        ColorSequenceKeypoint.new(1, lerpColor(o3))
    })
    
    subGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, lerpColor(o2):Lerp(Color3.new(1, 1, 1), 0.3)),
        ColorSequenceKeypoint.new(0.5, lerpColor(o3)),
        ColorSequenceKeypoint.new(1, lerpColor(o1):Lerp(Color3.new(1, 1, 1), 0.3))
    })
    
    sliderFillGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, lerpColor(o1)),
        ColorSequenceKeypoint.new(1, lerpColor(o2))
    })
end)
