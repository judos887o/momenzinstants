table.insert(Shared.Connections[KEY_MAIN],RunService.Heartbeat:Connect(function()
    if not Shared.AutoStomp then return end
    local now=tick()
    if now-lastStomp<MIN_COOLDOWN then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and isDowned(p) and isInRange(p) then
            MAINEVENT:FireServer("STOMP")
            lastStomp=now
            return
        end
    end
end))

local function attachAndStomp(plr,leg)
    if Shared.__stompWorking then return end
    Shared.__stompWorking=true
    while Shared.StompNearestEnabled and isDowned(plr) do
        local myChar=LocalPlayer.Character
        if not myChar then break end
        local myHRP=myChar:FindFirstChild("HumanoidRootPart")
        local ch=plr.Character
        if not myHRP or not ch then break end
        if not leg or not leg.Parent then
            leg=nearestLegPart(ch,myHRP.Position)
            if not leg then break end
        end
        local thrp=ch:FindFirstChild("HumanoidRootPart")
        if not thrp then break end
        local dist=(myHRP.Position-leg.Position).Magnitude
        if dist>Shared.StompRadius then break end
        local desiredPos=leg.Position+Vector3.new(0,1.05,0.2)
        myHRP.CFrame=CFrame.new(desiredPos,thrp.Position)
        if Shared.AutoStomp and isInRange(plr) and tick()-lastStomp>=MIN_COOLDOWN then
            MAINEVENT:FireServer("STOMP")
            lastStomp=tick()
            break
        end
        RunService.Heartbeat:Wait()
    end
    Shared.__stompWorking=false
end

