local function isDowned(p)
    local ch=p.Character
    if not ch then return false end
    local body=ch:FindFirstChild("BodyEffects")
    local ko=body and (body:FindFirstChild("K.O") or body:FindFirstChild("KO"))
    local dead=body and body:FindFirstChild("Dead")
    if ko and ko.Value==true and not (dead and dead.Value==true) then return true end
    local hum=ch:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local s=hum:GetState()
    if s==Enum.HumanoidStateType.Ragdoll or s==Enum.HumanoidStateType.FallingDown or s==Enum.HumanoidStateType.Physics or hum.PlatformStand then return true end
    return false
end

local function isInRange(p)
    local myChar=LocalPlayer.Character
    if not myChar then return false end
    local myHRP=myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false end
    local ch=p.Character
    if not ch then return false end
    for _,part in ipairs(ch:GetChildren()) do
        if part:IsA("BasePart") and validBodyParts[part.Name] then
            if (myHRP.Position-part.Position).Magnitude<=TOUCH_RANGE then
                return true
            end
        end
    end
    return false
end

local function nearestLegPart(ch,refPos)
    local best,bestD
    for _,p in ipairs(ch:GetChildren()) do
        if p:IsA("BasePart") and legParts[p.Name] then
            local d=(refPos-p.Position).Magnitude
            if not bestD or d<bestD then best,bestD=p,d end
        end
    end
    return best,bestD
end

local function getNearestDowned(maxDist)
    local myChar=LocalPlayer.Character
    if not myChar then return end
    local myHRP=myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local bestPlr,bestPart,bestDist=nil,nil,math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and isDowned(p) then
            local ch=p.Character
            if ch then
                local leg,d=nearestLegPart(ch,myHRP.Position)
                if leg and d<bestDist then
                    bestPlr,bestPart,bestDist=p,leg,d
                end
            end
        end
    end
    if bestPlr and bestDist<= (maxDist or math.huge) then
        return bestPlr,bestPart,bestDist
    end
end

local function hookAnimForCharacter(ch)
    task.spawn(function()
        local hum=ch:WaitForChild("Humanoid",5)
        if not hum then return end
        local animator=hum:WaitForChild("Animator",5)
        if not animator then return end
        table.insert(Shared.Connections[KEY_MAIN],animator.AnimationPlayed:Connect(function(track)
            if not Shared.AutoStomp then return end
            local id=track.Animation and track.Animation.AnimationId or ""
            if tostring(id):find(ANIMATION_ID) then
                track:AdjustSpeed(ANIM_SPEED)
            end
        end))
    end)
end

if LocalPlayer.Character then hookAnimForCharacter(LocalPlayer.Character) end
