-- RING: weißer Outline-Ring (innen leer) via Mesh (Torus)
local oldRing=Workspace:FindFirstChild("Schmeckt_StompRadiusRing")
if oldRing then oldRing:Destroy() end
local ring=Instance.new("Part")
ring.Name="Schmeckt_StompRadiusRing"
ring.Anchored=true
ring.CanCollide=false
ring.CanQuery=false
ring.CanTouch=false
ring.Material=Enum.Material.Neon
ring.Color=Color3.fromRGB(255,255,255)
ring.Transparency=0.35
ring.Size=Vector3.new(1,1,1)
ring.Parent=Workspace

local ringMesh=Instance.new("SpecialMesh")
ringMesh.MeshType=Enum.MeshType.FileMesh
ringMesh.MeshId="rbxassetid://3270017" -- Ring/Torus Mesh
ringMesh.Parent=ring
local RING_THICKNESS=0.12

local rcParams=RaycastParams.new()
rcParams.FilterType=Enum.RaycastFilterType.Exclude
rcParams.IgnoreWater=true

local function updateRing()
    local ch=LocalPlayer.Character
    local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    rcParams.FilterDescendantsInstances={ch}
    local res=Workspace:Raycast(hrp.Position,Vector3.new(0,-100,0),rcParams)
    local pos=(res and res.Position or (hrp.Position-Vector3.new(0,3,0)))+Vector3.new(0,0.03,0)
    local d=math.max(Shared.StompRadius*2,0.1)
    ringMesh.Scale=Vector3.new(d,RING_THICKNESS,d)
    ring.CFrame=CFrame.new(pos)
    ring.Transparency = Shared.StompNearestEnabled and 0.35 or 1
end

table.insert(Shared.Connections[KEY_MAIN],RunService.Heartbeat:Connect(function()
    updateRing()
    if not Shared.StompNearestEnabled then return end
    if Shared.__stompWorking then return end
    local p,leg=getNearestDowned(Shared.StompRadius)
    if p and leg then
        attachAndStomp(p,leg)
    end
end))
