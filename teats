            pcall(function() c:Disconnect() end)
        end
        Shared.Connections[key] = {}
    end
    if InstantStompGui then
        pcall(function() InstantStompGui:Destroy() end)
    end
    local rf = Workspace:FindFirstChild("Schmeckt_InstantStomp_Ring")
    if rf then
        pcall(function() rf:Destroy() end)
    end
end

