local function safeParentScreenGui(gui)
    local ok=false
    if syn and syn.protect_gui then pcall(function() syn.protect_gui(gui); gui.Parent=CoreGui; ok=true end) end
    if not ok then ok=pcall(function() gui.Parent=CoreGui end) end
    if not ok then
        local pg=LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui",3)
        if pg then gui.Parent=pg else gui.Parent=CoreGui end
    end
end

local ANIMATION_ID="127290980842135"
local TOUCH_RANGE=15
local ANIM_SPEED=100
local MIN_COOLDOWN=0.05
local lastStomp=0

local validBodyParts={
    ["Head"]=true,["HumanoidRootPart"]=true,["Torso"]=true,["Left Leg"]=true,["Right Leg"]=true,["Left Arm"]=true,["Right Arm"]=true,
    ["UpperTorso"]=true,["LowerTorso"]=true,["LeftUpperArm"]=true,["LeftLowerArm"]=true,["RightUpperArm"]=true,["RightLowerArm"]=true,
    ["LeftHand"]=true,["RightHand"]=true,["LeftUpperLeg"]=true,["LeftLowerLeg"]=true,["RightUpperLeg"]=true,["RightLowerLeg"]=true,
    ["LeftFoot"]=true,["RightFoot"]=true
}
local legParts={
    ["LeftFoot"]=true,["RightFoot"]=true,["LeftLowerLeg"]=true,["RightLowerLeg"]=true,["LeftUpperLeg"]=true,["RightUpperLeg"]=true,["LeftLeg"]=true,["RightLeg"]=true
}

local function isDowned(p)
    local ch=p and p.Character; if not ch then return false end
    local be=ch:FindFirstChild("BodyEffects")
    local KO=be and (be:FindFirstChild("K.O") or be:FindFirstChild("KO"))
    local Dead=be and be:FindFirstChild("Dead")
    if KO and KO.Value==true and not (Dead and Dead.Value==true) then return true end
    local hum=ch:FindFirstChildOfClass("Humanoid"); if not hum then return false end
    local s=hum:GetState()
    if s==Enum.HumanoidStateType.Ragdoll or s==Enum.HumanoidStateType.FallingDown or s==Enum.HumanoidStateType.Physics or hum.PlatformStand then
        return true
    end
    return false
end

local function isInRange(p)
    local myChar=LocalPlayer.Character; if not myChar then return false end
    local myHRP=myChar:FindFirstChild("HumanoidRootPart"); if not myHRP then return false end
    local ch=p.Character; if not ch then return false end
    for _,part in ipairs(ch:GetChildren()) do
        if part:IsA("BasePart") and validBodyParts[part.Name] then
            if (myHRP.Position-part.Position).Magnitude<=TOUCH_RANGE then return true end
        end
    end
    return false
end

local function nearestLegPart(ch,refPos)
    local best,bestD
    for _,p in ipairs(ch:GetChildren()) do
        if p:IsA("BasePart") and legParts[p.Name] then
            local d=(refPos-p.Position).Magnitude
            if not bestD or d<bestD then best,bestD=p,d end
        end
    end
    return best,bestD
end

local function getNearestDowned(maxDist)
    local myChar=LocalPlayer.Character; if not myChar then return end
    local myHRP=myChar:FindFirstChild("HumanoidRootPart"); if not myHRP then return end
    local bestPlr,bestPart,bestDist=nil,nil,math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and isDowned(p) then
            local ch=p.Character
            if ch then
                local leg,d=nearestLegPart(ch,myHRP.Position)
                if leg and d<bestDist then
                    bestPlr,bestPart,bestDist=p,leg,d
                end
            end
        end
    end
    if bestPlr and bestDist<= (maxDist or math.huge) then
        return bestPlr,bestPart,bestDist
    end
end

local function hookAnimForCharacter(ch)
    task.spawn(function()
        local hum=ch:WaitForChild("Humanoid",5); if not hum then return end
        local animator=hum:WaitForChild("Animator",5); if not animator then return end
        table.insert(Shared.Connections[KEY_CORE], animator.AnimationPlayed:Connect(function(track)
            local id=track.Animation and track.Animation.AnimationId or ""
            if tostring(id):find(ANIMATION_ID) then track:AdjustSpeed(ANIM_SPEED) end
        end))
    end)
end

table.insert(Shared.Connections[KEY_CORE], RunService.Heartbeat:Connect(function()
    local now=tick(); if now-lastStomp<MIN_COOLDOWN then return end
    local myChar=LocalPlayer.Character; if not myChar then return end
    local myHRP=myChar:FindFirstChild("HumanoidRootPart"); if not myHRP then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and isDowned(p) and isInRange(p) then
            if MAINEVENT then MAINEVENT:FireServer("STOMP") end
            lastStomp=now
            return
        end
    end
end))

table.insert(Shared.Connections[KEY_CORE], RunService.Heartbeat:Connect(function()
    if not Shared.StompNearestEnabled then return end
    local myChar=LocalPlayer.Character; if not myChar then return end
    local myHRP=myChar:FindFirstChild("HumanoidRootPart"); if not myHRP then return end
    local target,leg=getNearestDowned(Shared.StompRadius)
    if target and leg then
        local thrp=target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if thrp then
            local desired=leg.Position+Vector3.new(0,1.05,0.2)
            myHRP.CFrame=CFrame.new(desired,thrp.Position)
        end
    end
end))

