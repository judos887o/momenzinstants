local function posToRad(x)
    local bx = SliderBar.AbsolutePosition.X
    local w = SliderBar.AbsoluteSize.X
    local u = (w > 0) and math.clamp((x - bx) / w, 0, 1) or 0
    setRadius(u * 50)
end

